include(${CMAKE_CURRENT_LIST_DIR}/stream.cmake)
if(NOT TARGET TracyEventStore)
    set(store_dir ${CMAKE_CURRENT_LIST_DIR}/../stream)
    enable_language(C)
    add_library(TracyStoreSqlite STATIC ${store_dir}/third_party/sqlite/sqlite3.c)
    target_include_directories(TracyStoreSqlite PUBLIC ${store_dir}/third_party/sqlite)
    target_compile_definitions(TracyStoreSqlite PRIVATE SQLITE_ENABLE_RTREE SQLITE_THREADSAFE=1 SQLITE_DEFAULT_MEMSTATUS=1)
    set_property(TARGET TracyStoreSqlite PROPERTY INTERPROCEDURAL_OPTIMIZATION FALSE)
    add_library(TracyStoreCodec STATIC ${CMAKE_CURRENT_LIST_DIR}/../public/common/tracy_lz4.cpp)
    set_property(TARGET TracyStoreCodec PROPERTY INTERPROCEDURAL_OPTIMIZATION FALSE)
    if(WIN32)
        add_library(TracySnapshotStream STATIC ${store_dir}/src/TracySnapshotStream.cpp)
        target_include_directories(TracySnapshotStream PUBLIC ${store_dir}/src)
        target_compile_features(TracySnapshotStream PUBLIC cxx_std_20)
        target_compile_definitions(TracySnapshotStream PRIVATE NOMINMAX WIN32_LEAN_AND_MEAN)
        target_link_libraries(TracySnapshotStream PRIVATE TracyStoreCodec Bcrypt)
        set_property(TARGET TracySnapshotStream PROPERTY INTERPROCEDURAL_OPTIMIZATION FALSE)
    endif()
    add_library(TracyEventStore STATIC ${store_dir}/src/TracyEventStore.cpp ${store_dir}/src/TracyEventStoreCatalog.inl ${store_dir}/src/TracyEventStoreCodeIngest.inl ${store_dir}/src/TracyEventStoreCodeRead.inl ${store_dir}/src/TracyEventStoreExport.inl ${store_dir}/src/TracySnapshotValidate.inl)
    target_include_directories(TracyEventStore PUBLIC ${store_dir}/src)
    target_sources(TracyEventStore PRIVATE ${store_dir}/src/TracyEventStoreAnalysis.inl)
    target_sources(TracyEventStore PRIVATE ${store_dir}/src/TracyEventStoreTimeline.inl)
    target_sources(TracyEventStore PRIVATE ${store_dir}/src/TracyEventStoreTelemetry.inl)
    target_sources(TracyEventStore PRIVATE ${store_dir}/src/TracyEventStoreTranscript.inl)
    target_compile_features(TracyEventStore PUBLIC cxx_std_20)
    target_link_libraries(TracyEventStore PUBLIC TracyStreamCore PRIVATE TracyStoreSqlite TracyStoreCodec)
    set_property(TARGET TracyEventStore PROPERTY INTERPROCEDURAL_OPTIMIZATION FALSE)
    if(WIN32)
        target_compile_definitions(TracyEventStore PRIVATE NOMINMAX WIN32_LEAN_AND_MEAN)
        target_link_libraries(TracyEventStore PRIVATE Bcrypt TracySnapshotStream)
    endif()
endif()
