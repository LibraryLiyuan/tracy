    TRACY_RESULT_FIELD( selectedMessage );
    TRACY_RESULT_FIELD( plots );
    TRACY_RESULT_FIELD( plotPoints );
    TRACY_RESULT_FIELD( parameters );
    TRACY_RESULT_FIELD( locks );
    TRACY_RESULT_FIELD( lockEvents );
