    TRACY_RESULT_FIELD( ioStages );
    TRACY_RESULT_FIELD( scriptFrames );
    TRACY_RESULT_FIELD( scriptEvents );
    TRACY_RESULT_FIELD( allocations );
    TRACY_RESULT_FIELD( memoryPools );
