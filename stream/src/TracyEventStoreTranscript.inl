// ProtocolOnly sessions declare deterministic deferred symbol expansion. Their
// definition requests depend only on client events, never the replay host's
// filesystem. Regenerate that request set independently on disk. The send and
// response observers may publish in either order, so compare at session close.
bool strictTranscript = false;
uint8_t handshakeStage = 0;
uint64_t terminateQueries = 0, disconnectQueries = 0, expectedQueryCount = 0;
std::array<std::optional<uint64_t>, 16> lastExpectedQuery;
// Direct-mapped set of (type, key) pairs already present in expected_queries.
// A hit only skips an INSERT OR IGNORE that could not change the table.
struct KnownQuery
{
    uint64_t key = 0;
    uint32_t type = UINT32_MAX;
};
std::vector<KnownQuery> knownQueries;
void ExpectQuery( ServerQuery type, uint64_t key )
{
    if( !strictTranscript || ( ( type == ServerQueryString || type == ServerQueryFrameName ) && key == 0 ) ) return;
    auto& last = lastExpectedQuery[size_t( type )];
    if( last && *last == key ) return;
    last = key;
    if( knownQueries.empty() ) knownQueries.resize( 65536 );
    auto& known = knownQueries[( ( key ^ ( uint64_t( type ) << 56 ) ) * 0x9E3779B97F4A7C15ull ) >> 48];
    if( known.type == uint32_t( type ) && known.key == key ) return;
    auto q = db.Prep( "INSERT OR IGNORE INTO expected_queries VALUES(?,?)" );
    Int( q, 1, type );
    Int( q, 2, key );
    db.Run( q );
    known = { key, uint32_t( type ) };
    if( sqlite3_changes( db.handle ) && ( ++expectedQueryCount & 4095 ) == 0 )
    {
        const auto pageSize = uint64_t( db.Scalar( "PRAGMA page_size" ) );
        const auto pages = uint64_t( db.Scalar( "PRAGMA page_count" ) ) + uint64_t( db.Scalar( "PRAGMA temp.page_count" ) );
        Require( pages <= options.diskBytes / pageSize, "Transcript workspace disk budget exceeded" );
    }
}
void TranscriptRecord( const RecordInfo& r, std::span<const uint8_t> p )
{
    if( r.type == RecordType::SessionBegin )
    {
        if( p.size() >= 24 && p[0] == 2 && p[1] == 0 )
        {
            uint32_t flags;
            memcpy( &flags, p.data() + 16, 4 );
            strictTranscript = ( flags & SessionBeginFlagDeferredSymbolExpansion ) != 0;
            if( strictTranscript ) db.Exec( "CREATE TEMP TABLE expected_queries(type INTEGER,key INTEGER,PRIMARY KEY(type,key)) WITHOUT ROWID" );
        }
        return;
    }
    if( !strictTranscript ) return;
    if( r.type == RecordType::ServerToClient )
    {
        if( r.flags == RecordFlagHandshake )
        {
            if( handshakeStage == 0 )
            {
                Require( p.size() == HandshakeShibbolethSize && memcmp( p.data(), HandshakeShibboleth, HandshakeShibbolethSize ) == 0, "Server handshake shibboleth differs" );
            }
            else
            {
                uint32_t version = 0;
                if( p.size() == 4 ) memcpy( &version, p.data(), 4 );
                Require( handshakeStage == 1 && p.size() == 4 && version == ProtocolVersion, "Server handshake version or order differs" );
            }
            ++handshakeStage;
        }
        else
        {
            Require( r.flags == RecordFlagServerQuery && handshakeStage == 5 && p.size() % ServerQueryPacketSize == 0, "Unexpected ordered server transcript packet" );
            while( !p.empty() )
            {
                ServerQueryPacket query;
                memcpy( &query, p.data(), sizeof( query ) );
                p = p.subspan( sizeof( query ) );
                Require( query.extra == 0, "Server query extra bytes differ from generated query" );
                switch( query.type )
                {
                case ServerQueryTerminate:
                    Require( query.ptr == 0 && ++terminateQueries == 1, "Invalid or duplicate terminate query" );
                    break;
                case ServerQueryDisconnect:
                    Require( query.ptr == 0 && terminateQueries == 0 && ++disconnectQueries == 1, "Invalid or out-of-order disconnect query" );
                    break;
                case ServerQueryString:
                case ServerQueryThreadString:
                case ServerQuerySourceLocation:
                case ServerQueryPlotName:
                case ServerQueryFrameName:
                case ServerQueryFiberName:
                case ServerQueryExternalName:
                case ServerQueryCallstackFrame:
                    Require( terminateQueries == 0, "Definition query follows terminate control" );
                    break;
                default: throw std::runtime_error( "Query is not generated by deterministic ProtocolOnly replay" );
                }
            }
        }
    }
    else if( r.type == RecordType::ClientToServer && ( r.flags & RecordFlagHandshake ) )
    {
        if( handshakeStage == 2 ) Require( p.size() == 1 && p[0] == HandshakeWelcome, "Client handshake status or order differs" );
        else if( handshakeStage == 3 )
        {
            Require( p.size() == WelcomeMessageSize, "Client welcome order differs" );
            WelcomeMessage welcome;
            memcpy( &welcome, p.data(), sizeof( welcome ) );
            if( !( welcome.flags & WelcomeFlag::OnDemand ) ) ++handshakeStage;
        }
        else Require( handshakeStage == 4 && p.size() == OnDemandPayloadMessageSize, "On-demand handshake order differs" );
        ++handshakeStage;
    }
    else if( r.type == RecordType::ClientToServer ) Require( handshakeStage == 5, "Client data precedes completed handshake" );
}
void TranscriptEvent( const ProtocolEventView& view )
{
    if( !strictTranscript ) return;
    const auto& e = view.fixed;
    auto current = [&] { ExpectQuery( ServerQueryThreadString, thread ); };
    switch( e.hdr.type )
    {
    case QueueType::ZoneBegin:
    case QueueType::ZoneBeginCallstack:
        ExpectQuery( ServerQuerySourceLocation, e.zoneBegin.srcloc );
        current();
        break;
    case QueueType::JnZoneBeginCallsite:
        ExpectQuery( ServerQuerySourceLocation, e.jnZoneBeginCallsite.srcloc );
        current();
        break;
    case QueueType::ZoneBeginAllocSrcLoc:
    case QueueType::ZoneBeginAllocSrcLocCallstack:
    case QueueType::ZoneEnd:
    case QueueType::ZoneValidation:
    case QueueType::Callstack:
    case QueueType::CallstackAlloc:
    case QueueType::Message:
    case QueueType::MessageColor:
    case QueueType::MessageCallstack:
    case QueueType::MessageColorCallstack:
    case QueueType::JnJobSchedule:
    case QueueType::JnJobConfig:
    case QueueType::JnJobDependency:
    case QueueType::JnGfxDispatch:
    case QueueType::JnGfxEntity:
    case QueueType::JnGfxLink:
    case QueueType::JnFrame:
    case QueueType::JnIoRequest:
    case QueueType::JnIoConfig:
    case QueueType::JnRelation:
    case QueueType::JnRuntimeDomainState:
    case QueueType::JnGpuReferencePass:
    case QueueType::JnGpuReferenceUse:
    case QueueType::JnGpuReferenceSetUse:
    case QueueType::JnGpuReferenceEnd:
        current();
        break;
    case QueueType::FrameMarkMsg:
    case QueueType::FrameMarkMsgStart:
    case QueueType::FrameMarkMsgEnd:
        ExpectQuery( ServerQueryFrameName, e.frameMark.name );
        break;
    case QueueType::SourceLocation:
        ExpectQuery( ServerQueryString, e.srcloc.name );
        ExpectQuery( ServerQueryString, e.srcloc.file );
        ExpectQuery( ServerQueryString, e.srcloc.function );
        break;
    case QueueType::LockAnnounce: ExpectQuery( ServerQuerySourceLocation, e.lockAnnounce.lckloc ); break;
    case QueueType::LockMark: ExpectQuery( ServerQuerySourceLocation, e.lockMark.srcloc ); break;
    case QueueType::LockWait:
    case QueueType::LockObtain:
    case QueueType::LockSharedWait:
    case QueueType::LockSharedObtain:
        ExpectQuery( ServerQueryThreadString, e.lockWait.thread );
        break;
    case QueueType::LockSharedRelease: ExpectQuery( ServerQueryThreadString, e.lockReleaseShared.thread ); break;
    case QueueType::PlotDataInt: ExpectQuery( ServerQueryPlotName, e.plotDataInt.name ); break;
    case QueueType::PlotDataFloat: ExpectQuery( ServerQueryPlotName, e.plotDataFloat.name ); break;
    case QueueType::PlotDataDouble: ExpectQuery( ServerQueryPlotName, e.plotDataDouble.name ); break;
    case QueueType::PlotConfig: ExpectQuery( ServerQueryPlotName, e.plotConfig.name ); break;
    case QueueType::MessageLiteral:
    case QueueType::MessageLiteralCallstack:
        current();
        ExpectQuery( ServerQueryString, e.messageLiteral.text );
        break;
    case QueueType::MessageLiteralColor:
    case QueueType::MessageLiteralColorCallstack:
        current();
        ExpectQuery( ServerQueryString, e.messageColorLiteral.text );
        break;
    case QueueType::GpuZoneBegin:
    case QueueType::GpuZoneBeginCallstack:
    case QueueType::GpuZoneBeginSerial:
    case QueueType::GpuZoneBeginCallstackSerial:
        ExpectQuery( ServerQuerySourceLocation, e.gpuZoneBegin.srcloc );
        break;
    case QueueType::JnGpuZoneBeginCallsite: ExpectQuery( ServerQuerySourceLocation, e.jnGpuZoneBeginCallsite.srcloc ); break;
    case QueueType::MemAlloc:
    case QueueType::MemAllocCallstack:
    case QueueType::MemAllocNamed:
    case QueueType::MemAllocCallstackNamed:
    case QueueType::JnMemAllocCallsiteNamed:
        if( e.hdr.type == QueueType::MemAllocNamed || e.hdr.type == QueueType::MemAllocCallstackNamed || e.hdr.type == QueueType::JnMemAllocCallsiteNamed ) ExpectQuery( ServerQueryString, memoryName );
        ExpectQuery( ServerQueryThreadString, e.memAlloc.thread );
        break;
    case QueueType::MemFree:
    case QueueType::MemFreeCallstack:
    case QueueType::MemFreeNamed:
    case QueueType::MemFreeCallstackNamed:
        if( e.hdr.type == QueueType::MemFreeNamed || e.hdr.type == QueueType::MemFreeCallstackNamed ) ExpectQuery( ServerQueryString, memoryName );
        ExpectQuery( ServerQueryThreadString, e.memFree.thread );
        break;
    case QueueType::MemDiscard:
    case QueueType::MemDiscardCallstack:
        ExpectQuery( ServerQueryString, e.memDiscard.name );
        ExpectQuery( ServerQueryThreadString, e.memDiscard.thread );
        break;
    case QueueType::CallstackSample:
    case QueueType::CallstackSampleContextSwitch:
        ExpectQuery( ServerQueryThreadString, e.callstackSample.thread );
        break;
    case QueueType::CallstackSampleRef:
    case QueueType::CallstackSampleContextSwitchRef:
        ExpectQuery( ServerQueryThreadString, e.callstackSampleRef.thread );
        break;
    case QueueType::CallstackPayload:
    case QueueType::CallstackSampleDictionary:
        for( size_t offset = 0; offset + 8 <= view.payload.size(); offset += 8 )
        {
            uint64_t address;
            memcpy( &address, view.payload.data() + offset, 8 );
            ExpectQuery( ServerQueryCallstackFrame, ( address & 0x3FFFFFFFFFFFFFFF ) | ( ( address & 0x3000000000000000 ) << 2 ) );
        }
        break;
    case QueueType::CrashReport:
        current();
        ExpectQuery( ServerQueryString, e.crashReport.text );
        break;
    case QueueType::SysPowerReport: ExpectQuery( ServerQueryString, e.sysPower.name ); break;
    case QueueType::ContextSwitch:
        if( e.contextSwitch.newThread ) ExpectQuery( ServerQueryExternalName, e.contextSwitch.newThread );
        break;
    case QueueType::ParamSetup: ExpectQuery( ServerQueryString, e.paramSetup.name ); break;
    case QueueType::FiberEnter:
        ExpectQuery( ServerQueryFiberName, e.fiberEnter.fiber );
        ExpectQuery( ServerQueryThreadString, e.fiberEnter.thread );
        break;
    case QueueType::JnJobType: ExpectQuery( ServerQueryString, e.jnJobType.name ); break;
    case QueueType::JnScriptFrame:
        ExpectQuery( ServerQueryString, e.jnScriptFrame.function );
        ExpectQuery( ServerQueryString, e.jnScriptFrame.file );
        current();
        break;
    case QueueType::JnScriptStack:
        if( JnScriptRecordKind( e.jnScriptStack.kind ) == JnScriptRecordKind::Marker ) ExpectQuery( ServerQueryString, e.jnScriptStack.secondaryId );
        current();
        break;
    case QueueType::JnCallsiteDefinition: ExpectQuery( ServerQuerySourceLocation, e.jnCallsiteDefinition.srcloc ); break;
    case QueueType::JnJobStage:
        if( JnJobStage( e.jnJobStage.stage ) == JnJobStage::ScheduleCallstack || JnJobStage( e.jnJobStage.stage ) == JnJobStage::WaitCallstack ) ExpectQuery( ServerQueryThreadString, e.jnJobStage.arg0 );
        else current();
        break;
    case QueueType::JnIoStage:
        if( JnIoStage( e.jnIoStage.stage ) == JnIoStage::RequestCallstack ) ExpectQuery( ServerQueryThreadString, e.jnIoStage.detail );
        else current();
        break;
    default: break;
    }
}
void FinishTranscript( bool partial )
{
    if( !strictTranscript || partial || !info.cleanEnd ) return;
    Require( handshakeStage == 5 && terminateQueries == 1, "Incomplete ordered server transcript" );
    Require( db.Scalar( "SELECT COUNT(*) FROM (SELECT type,key FROM queries WHERE type NOT IN(0,9) GROUP BY type,key HAVING COUNT(*)!=1 OR MAX(extra)!=0)" ) == 0, "Duplicate or altered generated server query" );
    Require( db.Scalar( "SELECT COUNT(*) FROM (SELECT type,key FROM queries WHERE type NOT IN(0,9) EXCEPT SELECT type,key FROM expected_queries)" ) == 0, "Recorded server query is not generated by client events" );
    auto missing = db.Prep( "SELECT type,key FROM expected_queries EXCEPT SELECT type,key FROM queries WHERE type NOT IN(0,9) LIMIT 1" );
    if( db.Step( missing ) )
    {
        const auto type = sqlite3_column_int64( missing, 0 );
        const auto key = uint64_t( sqlite3_column_int64( missing, 1 ) );
        sqlite3_reset( missing );
        throw std::runtime_error( "Generated server query is absent from transcript: type=" + std::to_string( type ) + " key=" + std::to_string( key ) );
    }
    sqlite3_reset( missing );
    Require( db.Scalar( "SELECT COUNT(*) FROM queries WHERE type NOT IN(0,9) AND used=0" ) == 0, "Complete transcript has unanswered definition queries" );
    info.transcriptVerified = true;
}
