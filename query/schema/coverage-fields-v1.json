  "non_persisted": [
    {
      "field": "fiber_to_thread_map",
      "classification": "runtime_only",
      "reason": "Worker::DataBlock contains the live map, but Worker::Write does not persist it."
    },
    {
      "field": "per_sample_kernel_user_classification",
      "classification": "runtime_only",
      "reason": "Only the per-thread kernel sample count and ordered samples are persisted."
    },
    {
      "field": "gpu_live_calibration_state",
      "classification": "runtime_only",
      "members": ["timeDiff", "calibratedGpuTime", "calibratedCpuTime", "calibrationMod", "lastGpuTime", "overflowMul"],
      "reason": "Worker::Write persists the calibration flag, period, type, overflow and notes, but not these live calibration members."
    },
    {
      "field": "parent_callstack_payload_and_frames",
      "classification": "runtime_only",
      "reason": "Parent callstacks are assembled while processing live callstack tree responses. Worker::Write does not persist parentCallstackPayload, parentCallstackMap, or parentCallstackFrameMap; saved traces therefore report this capability as unavailable when those containers are absent."
    }
  ],
  "internal_exclusions": [
    {
      "area": "synchronization",
      "members": ["mainThreadWantsLock", "lockCv", "lock"],
      "classification": "internal_cache",
      "reason": "Worker synchronization, not capture data."
    },
    {
      "area": "indexes_and_caches",
      "members": [
        "revFrameMap",
        "revParentFrameMap",
        "zoneVectorCache",
        "threadDataLast",
        "ctxSwitchLast",
        "sourceLocationZonesReady",
        "gpuSourceLocationZonesReady",
        "ctxUsageReady"
      ],
      "classification": "internal_cache",
      "reason": "Reconstructible indexes and lookup caches."
    },
    {
      "area": "serialization_identity_tables",
      "members": [
        "stringData",
        "stringMap",
        "threadCompression",
        "threadExpand",
        "sourceLocationPayloadMap",
        "frameImageCompressionDictionary"
      ],
      "classification": "storage_identity",
      "reason": "Encoding and deduplication tables are resolved into their semantic strings, native thread IDs, source-location records, or decompressed BC1 bytes. Their container order, addresses, and compression bytes do not carry additional capture semantics."
    },
    {
      "area": "staging_and_live_transport",
      "members": [
        "stacks",
        "pendingSample",
        "pendingWakeUp",
        "query arrays",
        "network queues",
        "frame image staging",
        "pending symbols"
      ],
      "classification": "internal_cache",
      "reason": "Live or load-time staging state is not part of a completed saved capture."
    }
  ]
}
