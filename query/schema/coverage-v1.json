    { "domain": "memory.gc", "worker_data": ["JNGC1 capability AppInfo", "JNGC1 Managed/Lua heap and collection messages"], "methods": ["memory.gc.summary", "memory.gc.events"], "status": "complete", "tests": ["N11 deterministic pairing", "old trace present=false", "snapshot/stream/replay MCP acceptance"] },
    { "domain": "lock", "worker_data": ["lockMap"], "methods": ["lock.list", "lock.get", "lock.timeline", "lock.contention_statistics"], "status": "complete", "tests": ["FakeTraceSource", "Worker validation"] },
    { "domain": "plot", "worker_data": ["plots"], "methods": ["plot.list", "plot.points", "plot.range", "plot.downsample", "plot.statistics"], "status": "complete", "tests": ["FakeTraceSource", "bounded statistics contract"] },
    { "domain": "message", "worker_data": ["messages", "thread messages"], "methods": ["message.search", "message.get"], "status": "complete", "tests": ["FakeTraceSource", "untrusted-data contract"] },
    { "domain": "job", "worker_data": ["JnTraceData jobTypes/jobSchedules/jobConfigs/jobDependencies/jobStages", "Job schema 2 Ready/QueueEnter/Dispatch/Steal/WaitCallstack"], "methods": ["job.search", "job.get", "job.dependencies", "job.critical_path", "job.statistics"], "status": "complete", "tests": ["FakeTraceSource", "N12 synthetic save/load", "N12 snapshot/stream/replay MCP acceptance"] },
    { "domain": "job.gfx", "worker_data": ["JnTraceData gfxDispatches/gfxEntities/gfxLinks"], "methods": ["job.gfx.statistics", "job.gfx_chain"], "status": "complete", "tests": ["FakeTraceSource", "JN synthetic capture save/load"] },
    { "domain": "io", "worker_data": ["JnTraceData ioRequests/ioConfigs/ioStages"], "methods": ["io.search", "io.get", "io.statistics", "io.chain"], "status": "complete", "tests": ["FakeTraceSource deterministic lifecycle and exact parent chain", "Worker schema 3 persistence"] },
    { "domain": "network", "worker_data": ["DeferredByUser policy record"], "methods": ["network.capabilities"], "status": "deferred_by_user", "tests": ["Query contract"] },
    { "domain": "statistics", "worker_data": ["derived indexes"], "methods": ["statistics.describe", "statistics.compute"], "status": "complete", "tests": ["deterministic percentile/statistics unit"] },
    { "domain": "compare", "worker_data": ["two trace sessions", "JNCI1 identity", "JNCTX1 context", "JNQ1 producer quality", "JNCAT1 stable definitions", "JNGT1 GPU taxonomy", "complete frame windows"], "methods": ["compare.compatibility", "compare.normalized", "compare.zones", "compare.frames", "compare.source"], "status": "complete", "tests": ["N15 compatibility hard/warning/info contract", "N15 common-window normalized comparison", "Fresh1/Fresh2 MCP integration"] },
    { "domain": "validation", "worker_data": ["all persisted domains"], "methods": ["validation.run"], "status": "complete", "tests": ["Worker integration", "asynchronous job integration"] }
