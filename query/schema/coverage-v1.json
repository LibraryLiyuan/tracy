    { "domain": "producer", "worker_data": ["JNQ1 producer configuration and TLS counter snapshots"], "methods": ["producer.list", "producer.get"], "status": "complete", "tests": ["disabled/unsupported/filtered/dropped/real-zero contract", "MCP generic inspect route"] },
