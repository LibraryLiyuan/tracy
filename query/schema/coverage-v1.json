    { "domain": "sample", "worker_data": ["samples", "ctxSwitchSamples", "ghostZones", "childSamples", "symbolStats"], "methods": ["sample.list", "sample.ghost_zones", "sample.symbol_statistics", "sample.flamegraph"], "status": "complete", "tests": ["FakeTraceSource", "Worker validation"] },
    { "domain": "hardware_sample", "worker_data": ["hwSamples", "hasBranchRetirement"], "methods": ["hardware_sample.address", "hardware_sample.counts", "hardware_sample.events", "hardware_sample.capabilities"], "status": "complete", "tests": ["FakeTraceSource", "pagination contract"] },
