    { "domain": "zone.gpu", "worker_data": ["gpuData", "gpuChildren", "gpuSourceLocationZones"], "methods": ["zone.gpu.contexts", "zone.gpu.search", "zone.gpu.get", "zone.gpu.tree", "zone.gpu.statistics", "zone.gpu.flamegraph"], "status": "complete", "tests": ["FakeTraceSource", "Worker validation", "two-trace compare"] },
