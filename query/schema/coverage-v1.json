    { "domain": "cpu", "worker_data": ["cpuTopology", "cpuData", "ctxUsage"], "methods": ["cpu.topology", "cpu.usage", "cpu.timeline"], "status": "complete", "tests": ["FakeTraceSource", "Worker validation"] },
    { "domain": "context_switch", "worker_data": ["ctxSwitch", "cpuData", "cpuThreadData"], "methods": ["context_switch.range", "context_switch.thread", "context_switch.statistics"], "status": "complete", "tests": ["FakeTraceSource", "Worker validation"] },
    { "domain": "frame", "worker_data": ["frames", "framesBase", "frameOffset", "JnTraceData frames"], "methods": ["frame.sets", "frame.list", "frame.get", "frame.statistics", "frame.outliers", "frame.range_mapping", "frame.identity"], "status": "complete", "tests": ["FakeTraceSource", "Worker smoke", "FrameIdentity MCP acceptance", "two-trace compare"] },
    { "domain": "frame_image", "worker_data": ["frameImage"], "methods": ["frame_image.list", "frame_image.metadata", "frame_image.resource", "frame_image.raw"], "status": "complete", "tests": ["FakeTraceSource", "MCP resource transcript"] },
