    { "domain": "memory", "worker_data": ["memData", "memNameMap", "memory plots"], "methods": ["memory.pools", "memory.events", "memory.get", "memory.active_at_time", "memory.frame_snapshot", "memory.diff", "memory.callstack_tree", "memory.leak_candidates"], "status": "complete", "tests": ["deterministic Memory unit", "Fresh1 Worker frame snapshot", "Profiler shared-core build"] },
