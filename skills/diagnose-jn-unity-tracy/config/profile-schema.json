{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jngame.local/schemas/diagnose-jn-unity-tracy-profile-v2.json",
  "title": "JN Unity Tracy diagnosis configuration files",
  "oneOf": [
    { "$ref": "#/$defs/project" },
    { "$ref": "#/$defs/budgets" },
    { "$ref": "#/$defs/attribution" },
    { "$ref": "#/$defs/local" }
  ],
  "$defs": {
    "project": {
      "type": "object",
      "required": ["kind", "schema_version", "project_id", "trace_contract", "capture", "analysis"],
      "properties": {
        "kind": { "const": "jntracy_project_profile" },
        "schema_version": { "const": 2 },
        "trace_contract": {
          "type": "object",
          "required": ["protocol", "query_schema", "jn_section", "gpu_catalog_schema"],
          "properties": {
            "protocol": { "const": 90 },
            "query_schema": { "const": "1.32.0" },
            "jn_section": { "const": 12 },
            "gpu_catalog_schema": { "const": 1 }
          }
        },
        "analysis": {
          "type": "object",
          "required": ["single_trace_only", "deep_query_batch_size", "spike_detection", "significance", "query_limits", "diagnostic_branches"],
          "properties": {
            "single_trace_only": { "const": true },
            "deep_query_batch_size": { "type": "integer", "minimum": 1, "maximum": 100 },
            "spike_detection": {
              "type": "object",
              "required": ["recurrent_min_count"],
              "properties": {
                "recurrent_min_count": { "type": "integer", "minimum": 3 }
              }
            }
          }
        }
      }
    },
    "budgets": {
      "type": "object",
      "required": ["kind", "schema_version", "frame", "main_thread_categories", "logic_subcategories", "capacity"],
      "properties": {
        "kind": { "const": "jntracy_performance_budgets" },
        "schema_version": { "const": 1 }
      }
    },
    "attribution": {
      "type": "object",
      "required": ["kind", "schema_version", "rules", "audit"],
      "properties": {
        "kind": { "const": "jntracy_marker_attribution" },
        "schema_version": { "const": 1 }
      }
    },
    "local": {
      "type": "object",
      "required": ["kind", "schema_version", "paths", "source_roots", "target_launch", "elevation"],
      "properties": {
        "kind": { "const": "jntracy_local_profile" },
        "schema_version": { "const": 1 },
        "paths": {
          "type": "object",
          "required": ["toolchain_root", "python_exe", "capture_output_root", "analysis_output_root", "query_index_root"]
        }
      }
    }
  }
}
