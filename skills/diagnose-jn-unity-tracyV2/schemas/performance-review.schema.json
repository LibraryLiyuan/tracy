{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "candidate_views": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "candidate_id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "classification": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "level": {
                "enum": [
                  "frame_window",
                  "event",
                  "resource_operation"
                ]
              },
              "pattern": {
                "type": "string",
                "minLength": 1
              },
              "cost_kind": {
                "type": "string",
                "minLength": 1
              },
              "domain": {
                "type": "string",
                "minLength": 1
              },
              "frame_scope": {
                "type": "string"
              },
              "thread_or_queue": {
                "type": "string"
              },
              "selection_reasons": {
                "type": "array",
                "minItems": 0,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "required": [
              "level",
              "pattern",
              "cost_kind",
              "domain",
              "frame_scope",
              "thread_or_queue",
              "selection_reasons"
            ]
          },
          "query_priority": {
            "type": "string"
          },
          "analysis_priority": {
            "enum": [
              "P0",
              "P1",
              "P2",
              "P3"
            ]
          }
        },
        "required": [
          "candidate_id",
          "name",
          "classification"
        ]
      }
    },
    "evidence_labels": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "events": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "event_id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "thread_name": {
            "type": "string",
            "minLength": 1
          },
          "evidence_id": {
            "type": "string",
            "minLength": 1
          },
          "pointer": {
            "type": "string",
            "minLength": 1
          },
          "parent_event_id": {
            "type": "string",
            "minLength": 1
          },
          "ancestry_gap": {
            "type": "string",
            "minLength": 1
          },
          "timing_gap": {
            "type": "string",
            "minLength": 1
          },
          "display_name": {
            "type": "string",
            "minLength": 1
          },
          "display_name_basis": {
            "enum": [
              "query_function",
              "unresolved_context"
            ]
          }
        },
        "required": [
          "event_id",
          "name",
          "thread_name",
          "evidence_id",
          "pointer"
        ]
      }
    },
    "sources": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "source_id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "repository": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "symbol": {
            "type": "string",
            "minLength": 1
          },
          "revision": {
            "type": "string",
            "minLength": 1
          },
          "behavior": {
            "type": "string",
            "minLength": 1
          },
          "conditions": {
            "type": "string",
            "minLength": 1
          },
          "existing_controls": {
            "type": "string",
            "minLength": 1
          },
          "runtime_support": {
            "type": "string",
            "minLength": 1
          },
          "line": {
            "type": "integer",
            "minimum": 1
          },
          "end_line": {
            "type": "integer",
            "minimum": 1
          },
          "snapshot": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-fA-F]{64}$"
              }
            },
            "required": [
              "path",
              "sha256"
            ]
          },
          "version_status": {
            "enum": [
              "matched",
              "unverified",
              "mismatch"
            ]
          },
          "evidence_refs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "repository_key": {
            "enum": [
              "engine",
              "package",
              "tracy"
            ]
          },
          "build_identity_evidence_id": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "source_id",
          "name",
          "repository",
          "path",
          "symbol",
          "revision",
          "behavior",
          "conditions",
          "existing_controls",
          "runtime_support",
          "line",
          "end_line",
          "snapshot",
          "version_status",
          "evidence_refs"
        ]
      }
    },
    "relations": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "relation_id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "meaning": {
            "type": "string",
            "minLength": 1
          },
          "evidence_id": {
            "type": "string",
            "minLength": 1
          },
          "pointer": {
            "type": "string",
            "minLength": 1
          },
          "from_event_id": {
            "type": "string",
            "minLength": 1
          },
          "to_event_id": {
            "type": "string",
            "minLength": 1
          },
          "relation": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "relation_id",
          "name",
          "meaning",
          "evidence_id",
          "pointer",
          "from_event_id",
          "to_event_id",
          "relation"
        ]
      }
    },
    "issues": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "issue_id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "source_applicability": {
            "type": "string",
            "minLength": 1
          },
          "mechanism": {
            "type": "string",
            "minLength": 1
          },
          "trigger": {
            "type": "string",
            "minLength": 1
          },
          "scope": {
            "type": "string",
            "minLength": 1
          },
          "conclusion": {
            "type": "string",
            "minLength": 1
          },
          "comparison_gap": {
            "type": "string",
            "minLength": 1
          },
          "sample_gap": {
            "type": "string",
            "minLength": 1
          },
          "candidate_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "source_refs": {
            "type": "array",
            "minItems": 0,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "relation_refs": {
            "type": "array",
            "minItems": 0,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "analysis_state": {
            "enum": [
              "complete",
              "blocked"
            ]
          },
          "readiness": {
            "enum": [
              "cost_located",
              "mechanism_supported",
              "cause_verified",
              "actionable",
              "rejected",
              "blocked"
            ]
          },
          "merge": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "basis": {
                "enum": [
                  "single_candidate",
                  "same_event",
                  "verified_mechanism"
                ]
              },
              "reason": {
                "type": "string",
                "minLength": 1
              },
              "evidence_refs": {
                "type": "array",
                "minItems": 0,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "required": [
              "basis",
              "reason"
            ]
          },
          "source_blocker": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "reason": {
                "type": "string",
                "minLength": 1
              },
              "searches": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "next_action": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "reason",
              "searches",
              "next_action"
            ]
          },
          "runtime_verification": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "claim": {
                "type": "string",
                "minLength": 1
              },
              "reason": {
                "type": "string",
                "minLength": 1
              },
              "counterexample_review": {
                "type": "string",
                "minLength": 1
              },
              "evidence_refs": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "required": [
              "claim",
              "reason",
              "counterexample_review",
              "evidence_refs"
            ]
          },
          "samples": {
            "type": "array",
            "minItems": 0,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "sample_id": {
                  "type": "string",
                  "minLength": 1
                },
                "reason": {
                  "type": "string",
                  "minLength": 1
                },
                "frame_name": {
                  "type": "string",
                  "minLength": 1
                },
                "frame_evidence_id": {
                  "type": "string",
                  "minLength": 1
                },
                "frame_pointer": {
                  "type": "string",
                  "minLength": 1
                },
                "timing_gap": {
                  "type": "string",
                  "minLength": 1
                },
                "role": {
                  "enum": [
                    "normal",
                    "peak",
                    "repeated",
                    "sustained",
                    "recovery",
                    "user_focus"
                  ]
                },
                "kind": {
                  "enum": [
                    "frame",
                    "gpu_interval",
                    "origin_frame",
                    "context"
                  ]
                },
                "event_ids": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "required": [
                "sample_id",
                "reason",
                "frame_name",
                "frame_evidence_id",
                "role",
                "event_ids"
              ]
            }
          },
          "discovery_steps": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "question": {
                  "type": "string",
                  "minLength": 1
                },
                "action": {
                  "type": "string",
                  "minLength": 1
                },
                "observation": {
                  "type": "string",
                  "minLength": 1
                },
                "judgment": {
                  "type": "string",
                  "minLength": 1
                },
                "evidence_refs": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "source_refs": {
                  "type": "array",
                  "minItems": 0,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "sample_ids": {
                  "type": "array",
                  "minItems": 0,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "required": [
                "question",
                "action",
                "observation",
                "judgment",
                "evidence_refs",
                "source_refs",
                "sample_ids"
              ]
            }
          },
          "counterevidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "observation": {
                  "type": "string",
                  "minLength": 1
                },
                "effect": {
                  "type": "string",
                  "minLength": 1
                },
                "evidence_refs": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "source_refs": {
                  "type": "array",
                  "minItems": 0,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "required": [
                "observation",
                "effect",
                "evidence_refs",
                "source_refs"
              ]
            }
          },
          "measurements": {
            "type": "array",
            "minItems": 0,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "scope": {
                  "type": "string",
                  "minLength": 1
                },
                "interpretation": {
                  "type": "string",
                  "minLength": 1
                },
                "evidence_id": {
                  "type": "string",
                  "minLength": 1
                },
                "pointer": {
                  "type": "string",
                  "minLength": 1
                },
                "quantity": {
                  "enum": [
                    "duration_ns",
                    "count",
                    "bytes",
                    "sampling_percent"
                  ]
                },
                "sample_ids": {
                  "type": "array",
                  "minItems": 0,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "required": [
                "name",
                "scope",
                "interpretation",
                "evidence_id",
                "pointer",
                "quantity",
                "sample_ids"
              ]
            }
          },
          "limitations": {
            "type": "array",
            "minItems": 0,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "next_actions": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "issue_id",
          "title",
          "source_applicability",
          "mechanism",
          "trigger",
          "scope",
          "conclusion",
          "candidate_ids",
          "source_refs",
          "analysis_state",
          "readiness",
          "merge",
          "samples",
          "discovery_steps",
          "counterevidence",
          "limitations",
          "next_actions"
        ]
      }
    },
    "dedup_review": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "issue_ids": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "evidence_refs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "source_refs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "issue_ids",
          "reason",
          "evidence_refs",
          "source_refs"
        ]
      }
    },
    "quality_notes": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "domain": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "evidence_refs": {
            "type": "array",
            "minItems": 0,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "domain",
          "description",
          "evidence_refs"
        ]
      }
    },
    "candidate_splits": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "candidate_id",
          "issue_ids",
          "reason",
          "evidence_refs",
          "source_refs"
        ],
        "properties": {
          "candidate_id": {
            "type": "string"
          },
          "issue_ids": {
            "type": "array",
            "minItems": 2,
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "evidence_refs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "source_refs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "profile_evidence_id": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "schema_version",
    "candidate_views",
    "evidence_labels",
    "events",
    "sources",
    "issues",
    "dedup_review",
    "profile_evidence_id"
  ]
}
